import java.util.*;

/*
  動的計画法(部分問題の解のメモ化)を使用すると高速化できる問題

  → 最短時間と最短ルートをメモ化

  AC x 14
  TLE x 5
*/

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int cntRooms = sc.nextInt();
		int[] minutesA = new int[cntRooms - 1];
		int[] minutesB = new int[cntRooms - 2];
		for (int i = 0; i < cntRooms - 1; i++) {
			minutesA[i] = sc.nextInt();
		}
		for (int i = 0; i < cntRooms - 2; i++) {
			minutesB[i] = sc.nextInt();
		}

		int[] minuteMin = new int[cntRooms - 1];
		minuteMin[2 - 2] = minutesA[2 - 2];
		minuteMin[3 - 2] = Math.min(minutesA[2 - 2] + minutesA[3 - 2], minutesB[3 - 3]);

		ArrayList<ArrayList<Integer>> routes = new ArrayList<>();
		ArrayList<Integer> routeToRoom2 = new ArrayList<>();
		routeToRoom2.add(1);
		routeToRoom2.add(2);
		routes.add(routeToRoom2);

		ArrayList<Integer> routeToRoom3 = new ArrayList<>();
		routeToRoom3.add(1);
		if (minutesA[2 - 2] + minutesA[3 - 2] < minutesB[3 - 3]) {
			routeToRoom3.add(2);
		}
		routeToRoom3.add(3);
		routes.add(routeToRoom3);

		for (int toRoomNum = 4; toRoomNum <= cntRooms; toRoomNum++) {
			minuteMin[toRoomNum - 2] = Math.min(minuteMin[(toRoomNum - 2) - 1] + minutesA[toRoomNum - 2],
					minuteMin[(toRoomNum - 2) - 2] + minutesB[toRoomNum - 3]);

			ArrayList<Integer> routeToRoomTmp = new ArrayList<>();
			if (minuteMin[(toRoomNum - 2) - 1] + minutesA[toRoomNum - 2] > minuteMin[(toRoomNum - 2) - 2]
					+ minutesB[toRoomNum - 3]) {
				routeToRoomTmp.addAll(routes.get((toRoomNum - 2) - 2));
				routeToRoomTmp.add(toRoomNum);
			} else {
				routeToRoomTmp.addAll(routes.get((toRoomNum - 2) - 1));
				routeToRoomTmp.add(toRoomNum);
			}
			routes.add(routeToRoomTmp);
		}

		ArrayList<Integer> lastRoute = routes.get((cntRooms - 1) - 1);
		StringJoiner sj = new StringJoiner(" ");
		for (int i = 0; i < lastRoute.size(); i++) {
			sj.add(String.valueOf(lastRoute.get(i)));
		}
		System.out.println(lastRoute.size());
		System.out.println(sj.toString());
	}
}
