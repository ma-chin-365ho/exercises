import java.util.*;

/*
  二分探索法を使用して解く問題。

  int型の最大値は、2,147,483,647 > 10^9

  ACx15 WAx6

  TODO: WAの理由が分からない。
*/

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int cntPrinters = sc.nextInt();
		long cntFlyers = sc.nextInt();
		long[] intervalPrints = new long[cntPrinters];
		for (int i = 0; i < cntPrinters; i++) {
			intervalPrints[i] = sc.nextInt();
		}

		long stSec = 1;
		long endSec = (long) Math.pow(10, 9);
		// System.out.println(endSec);
		long centerSec = 0;
		long tmpCntFlyers = 0;
		while (true) {
			centerSec = (endSec - stSec) / 2 + stSec;

			// System.out.println("==============");
			// System.out.println(stSec);
			// System.out.println(centerSec);
			// System.out.println(endSec);
			// System.out.println("==============");
			tmpCntFlyers = getCntFlyers(intervalPrints, cntPrinters, centerSec);
			if (endSec - stSec == 0) {
				System.out.println(stSec);
				break;
			} else if (endSec - stSec == 1) {
				// NOTE:この場合 1 / 2 = 0なので、必ずcenterSec == stSecとなる。
				if (tmpCntFlyers >= cntFlyers) {
					System.out.println(stSec);
				} else {
					System.out.println(endSec);
				}
				break;
			} else if (tmpCntFlyers > cntFlyers)
				endSec = centerSec;
			else
				stSec = centerSec;
		}
	}

	private static long getCntFlyers(long[] intervalPrints, long cntPrinters, long sec) {
		long sum = 0;
		for (int i = 0; i < cntPrinters; i++) {
			sum += sec / intervalPrints[i];
		}
		return sum;
	}
}
